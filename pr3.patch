+    const sets = normalizeHarmonySets(vowelHarmonySets);
+    if (sets.length === 0) {
+        return { conforms: true, foundVowels: [], matchingSet: -1, mixedSets: [], matchingSetName: '' };
+    }
+
+    const wordVowels = extractVowelsFromWord(word, vowelsStr);
